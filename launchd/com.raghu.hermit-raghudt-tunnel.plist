<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.raghu.hermit-raghudt-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/raghu/bin/hermit-raghudt-tunnel</string>
    <string>run-once</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>NetworkState</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/raghu/Library/Logs/Hermit/raghudt-tunnel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/raghu/Library/Logs/Hermit/raghudt-tunnel.err.log</string>
</dict>
</plist>
