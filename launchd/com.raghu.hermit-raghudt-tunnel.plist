<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.raghu.hermit-raghudt-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/raghupathyk/bin/hermit-raghudt-tunnel</string>
    <string>run-once</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMIT_TUNNEL_REMOTE_HOST</key>
    <string>raghudt</string>
    <key>HERMIT_TUNNEL_REMOTE_HOST_FALLBACKS</key>
    <string>10.110.49.244</string>
    <key>HERMIT_TUNNEL_REMOTE_LISTEN_PORT</key>
    <string>22221</string>
    <key>HERMIT_TUNNEL_REMOTE_CLEANUP_IDENTITY_FILE</key>
    <string>/Users/raghupathyk/.ssh/hermit_raghudt_reverse_ed25519</string>
    <key>PATH</key>
    <string>/Users/raghupathyk/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>NetworkState</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/raghupathyk/Library/Logs/Hermit/raghudt-tunnel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/raghupathyk/Library/Logs/Hermit/raghudt-tunnel.err.log</string>
</dict>
</plist>
