#!/usr/bin/env bash
set -euo pipefail

LABEL="com.raghu.hermit-raghudt-tunnel"
REMOTE_USER="${HERMIT_TUNNEL_REMOTE_USER:-raghupathyk}"
REMOTE_HOST="${HERMIT_TUNNEL_REMOTE_HOST:-raghudt}"
REMOTE_HOST_FALLBACKS="${HERMIT_TUNNEL_REMOTE_HOST_FALLBACKS:-${HERMIT_TUNNEL_REMOTE_HOST_FALLBACK:-10.110.49.244}}"
ACTIVE_REMOTE_HOST="$REMOTE_HOST"
REMOTE_PORT="${HERMIT_TUNNEL_REMOTE_PORT:-22}"
REMOTE_LISTEN_HOST="${HERMIT_TUNNEL_REMOTE_LISTEN_HOST:-127.0.0.1}"
REMOTE_LISTEN_PORT="${HERMIT_TUNNEL_REMOTE_LISTEN_PORT:-22221}"
LOCAL_TARGET_HOST="${HERMIT_TUNNEL_LOCAL_TARGET_HOST:-127.0.0.1}"
LOCAL_TARGET_PORT="${HERMIT_TUNNEL_LOCAL_TARGET_PORT:-22}"
IDENTITY_FILE="${HERMIT_TUNNEL_IDENTITY_FILE:-$HOME/.ssh/hermit_raghudt_reverse_ed25519}"
REMOTE_CLEANUP_ENABLED="${HERMIT_TUNNEL_REMOTE_CLEANUP_ENABLED:-1}"
REMOTE_CLEANUP_IDENTITY_FILE="${HERMIT_TUNNEL_REMOTE_CLEANUP_IDENTITY_FILE:-$HOME/.ssh/id_ed25519}"
REMOTE_CLEANUP_MIN_AGE_SECONDS="${HERMIT_TUNNEL_REMOTE_CLEANUP_MIN_AGE_SECONDS:-120}"
APP_DIR="$HOME/Library/Application Support/Hermit"
LOG_DIR="$HOME/Library/Logs/Hermit"
CONTROL_SOCKET="$APP_DIR/raghudt-tunnel.ctl"
ACTION_STATE="$APP_DIR/raghudt-tunnel.last-action"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
PLIST_SOURCE="${HERMIT_TUNNEL_PLIST_SOURCE:-}"
PLIST_DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

usage() {
  cat <<USAGE
Usage: hermit-raghudt-tunnel <command>

Commands:
  install       Install the user LaunchAgent
  start         Install/load the LaunchAgent and start the tunnel now
  stop          Stop and unload the LaunchAgent
  toggle        Start when stopped, stop when connected/loaded
  restart       Stop, then start
  status        Print human-readable status
  quiet-status  Exit 0 only when the SSH master tunnel is connected
  loaded-status Exit 0 only when the LaunchAgent is loaded
  diagnose      Print launchd status, checks, and recent logs
  clear-remote-port
               Clear a stale raghudt listener on the reverse tunnel port
  show-status   Open a status report in TextEdit
  show-diagnose Open a diagnosis report in TextEdit
  show-logs     Open recent logs in TextEdit and Finder
  swiftbar-action <command>
               Run a command from SwiftBar and record visible feedback
  run-once      Internal launchd command; run one foreground tunnel process
  logs          Tail the tunnel logs
USAGE
}

ensure_dirs() {
  mkdir -p "$APP_DIR" "$LOG_DIR" "$HOME/Library/LaunchAgents"
  chmod 700 "$APP_DIR"
}

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

loaded() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

master_connected() {
  [[ -S "$CONTROL_SOCKET" ]] || return 1

  local host
  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    if /usr/bin/ssh \
      -S "$CONTROL_SOCKET" \
      -O check \
      -o BatchMode=yes \
      -o ConnectTimeout=3 \
      -o ConnectionAttempts=1 \
      -o LogLevel=ERROR \
      "$REMOTE_USER@$host" >/dev/null 2>&1; then
      ACTIVE_REMOTE_HOST="$host"
      return 0
    fi
  done < <(remote_host_candidates)

  return 1
}

remote_host_candidates() {
  local seen=" "
  local host
  for host in "$REMOTE_HOST" $REMOTE_HOST_FALLBACKS; do
    [[ -n "$host" ]] || continue
    case "$seen" in
      *" $host "*) ;;
      *)
        printf '%s\n' "$host"
        seen="$seen$host "
        ;;
    esac
  done
}

remote_host_summary() {
  remote_host_candidates | paste -sd ',' -
}

select_active_remote_host() {
  local host
  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    if /usr/bin/nc -G 5 -z "$host" "$REMOTE_PORT" >/dev/null 2>&1; then
      ACTIVE_REMOTE_HOST="$host"
      return 0
    fi
  done < <(remote_host_candidates)

  return 1
}

plist_escape() {
  local value="$1"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  value="${value//\"/&quot;}"
  printf '%s' "$value"
}

write_generated_plist() {
  local launch_path="${HERMIT_TUNNEL_LAUNCH_PATH:-$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}"

  {
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(plist_escape "$LABEL")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(plist_escape "$SCRIPT_PATH")</string>
    <string>run-once</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMIT_TUNNEL_REMOTE_HOST</key>
    <string>$(plist_escape "$REMOTE_HOST")</string>
    <key>HERMIT_TUNNEL_REMOTE_HOST_FALLBACKS</key>
    <string>$(plist_escape "$REMOTE_HOST_FALLBACKS")</string>
    <key>HERMIT_TUNNEL_REMOTE_LISTEN_PORT</key>
    <string>$(plist_escape "$REMOTE_LISTEN_PORT")</string>
    <key>HERMIT_TUNNEL_REMOTE_CLEANUP_IDENTITY_FILE</key>
    <string>$(plist_escape "$REMOTE_CLEANUP_IDENTITY_FILE")</string>
    <key>PATH</key>
    <string>$(plist_escape "$launch_path")</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>NetworkState</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>$(plist_escape "$LOG_DIR/raghudt-tunnel.log")</string>
  <key>StandardErrorPath</key>
  <string>$(plist_escape "$LOG_DIR/raghudt-tunnel.err.log")</string>
</dict>
</plist>
PLIST
  } > "$PLIST_DEST"
}

install_agent() {
  ensure_dirs
  if [[ -n "$PLIST_SOURCE" ]]; then
    if [[ ! -f "$PLIST_SOURCE" ]]; then
      printf 'Missing LaunchAgent source: %s\n' "$PLIST_SOURCE" >&2
      return 1
    fi
    cp "$PLIST_SOURCE" "$PLIST_DEST"
  else
    write_generated_plist
  fi
  plutil -lint "$PLIST_DEST" >/dev/null
  chmod 644 "$PLIST_DEST"
  printf 'Installed %s\n' "$PLIST_DEST"
}

start_agent() {
  install_agent >/dev/null
  if loaded; then
    launchctl kickstart -k "$DOMAIN/$LABEL"
  else
    launchctl bootstrap "$DOMAIN" "$PLIST_DEST"
  fi
  sleep 1
  status || true
}

stop_agent() {
  if master_connected; then
    /usr/bin/ssh \
      -S "$CONTROL_SOCKET" \
      -O exit \
      -o BatchMode=yes \
      -o LogLevel=ERROR \
      "$REMOTE_USER@$REMOTE_HOST" >/dev/null 2>&1 || true
  fi
  if loaded; then
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  fi
  rm -f "$CONTROL_SOCKET"
  printf 'Hermit raghudt tunnel stopped\n'
}

status() {
  if master_connected; then
    printf 'connected: %s:%s -> %s:%s via %s@%s\n' \
      "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT" \
      "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" \
      "$REMOTE_USER" "$ACTIVE_REMOTE_HOST"
    return 0
  fi

  if loaded; then
    printf 'retrying: LaunchAgent loaded but tunnel is not connected\n'
    print_recent_log_summary
    return 75
  fi

  printf 'stopped\n'
  return 1
}

print_recent_log_summary() {
  local last_log=""
  local last_error=""
  local log_mtime=0
  local err_mtime=0

  if [[ -f "$LOG_DIR/raghudt-tunnel.log" ]]; then
    last_log="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || true)"
    log_mtime="$(stat -f '%m' "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || printf '0')"
  fi
  if [[ -f "$LOG_DIR/raghudt-tunnel.err.log" ]]; then
    last_error="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || true)"
    err_mtime="$(stat -f '%m' "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || printf '0')"
  fi

  if [[ -n "$last_log" ]]; then
    printf 'last log: %s\n' "$last_log"
  fi
  if [[ -n "$last_error" ]]; then
    if (( err_mtime >= log_mtime )); then
      printf 'last error: %s\n' "$last_error"
    else
      printf 'previous error: %s\n' "$last_error"
    fi
  fi
}

remote_cleanup_ssh() {
  local args=(
    -x
    -o BatchMode=yes
    -o ConnectTimeout=10
    -o StrictHostKeyChecking=accept-new
    -p "$REMOTE_PORT"
  )

  if [[ -r "$REMOTE_CLEANUP_IDENTITY_FILE" ]]; then
    args+=(-i "$REMOTE_CLEANUP_IDENTITY_FILE" -o IdentitiesOnly=yes)
  fi

  /usr/bin/ssh "${args[@]}" "$REMOTE_USER@$ACTIVE_REMOTE_HOST" "$@"
}

remote_listener_occupied() {
  remote_cleanup_ssh /bin/bash -s -- "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT" <<'REMOTE' >/dev/null 2>&1
set -euo pipefail

listen_host="$1"
listen_port="$2"

if command -v ss >/dev/null 2>&1; then
  ss -H -ltn 2>/dev/null |
    awk -v host="$listen_host" -v port="$listen_port" '
      function matches(value) {
        if (value == host ":" port) return 1
        if (value == "[" host "]:" port) return 1
        if (host == "127.0.0.1" && value == "localhost:" port) return 1
        if (host == "127.0.0.1" && value == "0.0.0.0:" port) return 1
        if (host == "127.0.0.1" && value == "*:" port) return 1
        if (host == "::1" && value == "[::1]:" port) return 1
        if (value == "[::]:" port) return 1
        if (value == ":::" port) return 1
        return 0
      }
      matches($4) { found = 1 }
      END {
        if (found) exit 0
        exit 1
      }
    '
  exit $?
fi

/usr/bin/python3 - "$listen_host" "$listen_port" <<'PY'
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
family = socket.AF_INET6 if ":" in host else socket.AF_INET
sock = socket.socket(family, socket.SOCK_STREAM)
try:
    sock.bind((host, port))
except OSError:
    raise SystemExit(0)
raise SystemExit(1)
PY
REMOTE
}

clear_remote_port() {
  if [[ "$REMOTE_CLEANUP_ENABLED" != "1" ]]; then
    printf 'remote cleanup disabled (HERMIT_TUNNEL_REMOTE_CLEANUP_ENABLED=%s)\n' "$REMOTE_CLEANUP_ENABLED"
    return 75
  fi

  if ! select_active_remote_host; then
    printf 'raghudt is not reachable at any configured host (%s):%s; cannot clear remote port\n' "$(remote_host_summary)" "$REMOTE_PORT"
    return 75
  fi

  if ! remote_listener_occupied; then
    printf 'remote listener is already clear: %s:%s\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
    return 0
  fi

  remote_cleanup_ssh /bin/bash -s -- \
    "$REMOTE_LISTEN_HOST" \
    "$REMOTE_LISTEN_PORT" \
    "$REMOTE_CLEANUP_MIN_AGE_SECONDS" \
    "$REMOTE_USER" <<'REMOTE'
set -euo pipefail

listen_host="$1"
listen_port="$2"
min_age="$3"
remote_user="$4"

occupied() {
  if command -v ss >/dev/null 2>&1; then
    ss -H -ltn 2>/dev/null |
      awk -v host="$listen_host" -v port="$listen_port" '
        function matches(value) {
          if (value == host ":" port) return 1
          if (value == "[" host "]:" port) return 1
          if (host == "127.0.0.1" && value == "localhost:" port) return 1
          if (host == "127.0.0.1" && value == "0.0.0.0:" port) return 1
          if (host == "127.0.0.1" && value == "*:" port) return 1
          if (host == "::1" && value == "[::1]:" port) return 1
          if (value == "[::]:" port) return 1
          if (value == ":::" port) return 1
          return 0
        }
        matches($4) { found = 1 }
        END {
          if (found) exit 0
          exit 1
        }
      '
    return $?
  fi

  /usr/bin/python3 - "$listen_host" "$listen_port" <<'PY' >/dev/null 2>&1
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
family = socket.AF_INET6 if ":" in host else socket.AF_INET
sock = socket.socket(family, socket.SOCK_STREAM)
try:
    sock.bind((host, port))
except OSError:
    raise SystemExit(0)
raise SystemExit(1)
PY
}

if ! occupied; then
  printf 'remote listener is already clear: %s:%s\n' "$listen_host" "$listen_port"
  exit 0
fi

mapfile -t candidates < <(
  ps -u "$USER" -o pid=,etimes=,args= |
    awk -v min_age="$min_age" -v remote_user="$remote_user" '
      {
        pid=$1
        etimes=$2
        $1=""
        $2=""
        sub(/^  */, "")
        if ($0 == "sshd: " remote_user && etimes >= min_age) {
          print etimes ":" pid
        }
      }
    ' |
    sort -n
)

if [[ ${#candidates[@]} -eq 0 ]]; then
  printf 'remote listener is occupied, but no old Hermit-shaped sshd child was found\n'
  exit 75
fi

for candidate in "${candidates[@]}"; do
  age="${candidate%%:*}"
  pid="${candidate#*:}"
  printf 'killing stale remote sshd child pid=%s age=%ss\n' "$pid" "$age"
  kill "$pid" 2>/dev/null || true
  sleep 1

  if ! occupied; then
    printf 'remote listener cleared: %s:%s\n' "$listen_host" "$listen_port"
    exit 0
  fi
done

if occupied; then
  printf 'remote listener is still occupied after cleanup: %s:%s\n' "$listen_host" "$listen_port"
  exit 75
fi

printf 'remote listener cleared: %s:%s\n' "$listen_host" "$listen_port"
REMOTE
}

clear_remote_port_if_needed() {
  [[ "$REMOTE_CLEANUP_ENABLED" == "1" ]] || return 0
  remote_listener_occupied || return 0

  log "remote listener is occupied at $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT; attempting stale cleanup"
  local output=""
  local code=0
  set +e
  output="$(clear_remote_port 2>&1)"
  code=$?
  set -e
  while IFS= read -r line; do
    [[ -n "$line" ]] && log "remote cleanup: $line"
  done <<< "$output"
  return "$code"
}

notify() {
  local title="$1"
  local message="$2"
  /usr/bin/osascript -e "display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\"" >/dev/null 2>&1 || true
}

record_action() {
  ensure_dirs
  local command="$1"
  local code="$2"
  local output="$3"
  {
    printf '%s command=%s exit=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$command" "$code"
    printf '%s\n' "$output"
  } > "$ACTION_STATE"
}

write_status_report() {
  ensure_dirs
  local file="$APP_DIR/raghudt-tunnel-status.txt"
  {
    printf 'Hermit tunnel status\n'
    printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    status || true
  } > "$file"
  printf '%s\n' "$file"
}

write_diagnose_report() {
  ensure_dirs
  local file="$APP_DIR/raghudt-tunnel-diagnose.txt"
  diagnose > "$file" 2>&1 || true
  printf '%s\n' "$file"
}

write_logs_report() {
  ensure_dirs
  touch "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
  local file="$APP_DIR/raghudt-tunnel-logs.txt"
  {
    printf 'Hermit tunnel logs\n'
    printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'Standard log: %s\n' "$LOG_DIR/raghudt-tunnel.log"
    tail -n 200 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || true
    printf '\nError log: %s\n' "$LOG_DIR/raghudt-tunnel.err.log"
    tail -n 200 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || true
  } > "$file"
  printf '%s\n' "$file"
}

open_report() {
  local file="$1"
  /usr/bin/open -a TextEdit "$file"
}

show_status_report() {
  local file
  file="$(write_status_report)"
  open_report "$file"
  printf 'Opened status report: %s\n' "$file"
}

show_diagnose_report() {
  local file
  file="$(write_diagnose_report)"
  open_report "$file"
  printf 'Opened diagnosis report: %s\n' "$file"
}

show_logs_report() {
  local file
  file="$(write_logs_report)"
  open_report "$file"
  /usr/bin/open "$LOG_DIR" >/dev/null 2>&1 || true
  printf 'Opened logs report: %s\n' "$file"
  printf 'Opened log folder: %s\n' "$LOG_DIR"
}

swiftbar_action() {
  local command="${1:-}"
  if [[ -z "$command" ]]; then
    printf 'Missing SwiftBar command\n' >&2
    return 64
  fi

  record_action "$command" "running" "Running $command..."

  local output=""
  local code=0
  set +e
  case "$command" in
    show-status)
      output="$(show_status_report 2>&1)"
      ;;
    show-diagnose)
      output="$(show_diagnose_report 2>&1)"
      ;;
    show-logs)
      output="$(show_logs_report 2>&1)"
      ;;
    *)
      output="$("$0" "$command" 2>&1)"
      ;;
  esac
  code=$?
  set -e

  record_action "$command" "$code" "$output"

  local summary
  summary="$(printf '%s\n' "$output" | sed '/^[[:space:]]*$/d' | head -n 1)"
  if [[ -z "$summary" ]]; then
    summary="command finished with exit $code"
  fi

  notify "Hermit Tunnel" "$summary"
  printf '%s\n' "$output"
  return 0
}

diagnose() {
  ensure_dirs
  printf 'Hermit tunnel diagnosis\n'
  printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  printf 'Status:\n'
  status || true
  printf '\n'

  printf 'Checks:\n'
  if [[ -r "$IDENTITY_FILE" ]]; then
    printf '  identity: readable (%s)\n' "$IDENTITY_FILE"
  else
    printf '  identity: missing or unreadable (%s)\n' "$IDENTITY_FILE"
  fi
  if /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    printf '  remote SSH: reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  else
    printf '  remote SSH: NOT reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  fi
  local fallback_host
  while IFS= read -r fallback_host; do
    [[ "$fallback_host" == "$REMOTE_HOST" ]] && continue
    if /usr/bin/nc -G 5 -z "$fallback_host" "$REMOTE_PORT" >/dev/null 2>&1; then
      printf '  remote SSH fallback: reachable (%s:%s)\n' "$fallback_host" "$REMOTE_PORT"
    else
      printf '  remote SSH fallback: NOT reachable (%s:%s)\n' "$fallback_host" "$REMOTE_PORT"
    fi
  done < <(remote_host_candidates)
  if /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    printf '  local SSH: reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  else
    printf '  local SSH: NOT reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  fi
  if remote_listener_occupied; then
    printf '  remote listener: occupied (%s:%s)\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
  else
    printf '  remote listener: clear (%s:%s)\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
  fi
  printf '\n'

  printf 'LaunchAgent:\n'
  launchctl print "$DOMAIN/$LABEL" 2>&1 | sed -n '1,120p' || true
  printf '\n'

  printf 'Recent log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || printf '  no standard log yet\n'
  printf '\nRecent error log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || printf '  no error log yet\n'
}

run_once() {
  ensure_dirs
  umask 077

  if [[ ! -r "$IDENTITY_FILE" ]]; then
    log "identity file missing or unreadable: $IDENTITY_FILE"
    exit 78
  fi

  if master_connected; then
    log "tunnel already connected"
    exit 0
  fi

  rm -f "$CONTROL_SOCKET"

  if ! select_active_remote_host; then
    log "raghudt is not reachable at any configured host ($(remote_host_summary)):$REMOTE_PORT; will retry later"
    exit 75
  fi

  if ! /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    log "local SSH is not reachable at $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT"
    exit 75
  fi

  if ! clear_remote_port_if_needed; then
    log "remote listener cleanup did not clear $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT; will retry later"
    exit 75
  fi

  log "starting reverse tunnel: $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT -> $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT via $REMOTE_USER@$ACTIVE_REMOTE_HOST"

  local ssh_error_file="$APP_DIR/raghudt-tunnel.ssh.err"
  rm -f "$ssh_error_file"

  set +e
  /usr/bin/ssh \
    -M \
    -S "$CONTROL_SOCKET" \
    -N \
    -T \
    -i "$IDENTITY_FILE" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -o LogLevel=ERROR \
    -R "$REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT:$LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT" \
    -p "$REMOTE_PORT" \
    "$REMOTE_USER@$ACTIVE_REMOTE_HOST" 2>"$ssh_error_file"
  local ssh_code=$?
  set -e

  if [[ -s "$ssh_error_file" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] && log "ssh: $line"
    done < "$ssh_error_file"
  fi

  if [[ "$ssh_code" -eq 0 ]]; then
    log "ssh tunnel exited cleanly; will retry later"
    rm -f "$CONTROL_SOCKET"
    exit 75
  fi

  if grep -q "remote port forwarding failed for listen port $REMOTE_LISTEN_PORT" "$ssh_error_file" 2>/dev/null; then
    log "reverse tunnel bind failed after preflight; attempting stale cleanup and one retry"
    local output=""
    local cleanup_code=0
    set +e
    output="$(clear_remote_port 2>&1)"
    cleanup_code=$?
    set -e
    while IFS= read -r line; do
      [[ -n "$line" ]] && log "remote cleanup after bind failure: $line"
    done <<< "$output"
    if [[ "$cleanup_code" -eq 0 ]]; then
      rm -f "$CONTROL_SOCKET"
      log "retrying reverse tunnel after cleanup: $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT -> $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT via $REMOTE_USER@$ACTIVE_REMOTE_HOST"
      exec /usr/bin/ssh \
        -M \
        -S "$CONTROL_SOCKET" \
        -N \
        -T \
        -i "$IDENTITY_FILE" \
        -o IdentitiesOnly=yes \
        -o BatchMode=yes \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=3 \
        -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=accept-new \
        -o LogLevel=ERROR \
        -R "$REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT:$LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT" \
        -p "$REMOTE_PORT" \
        "$REMOTE_USER@$ACTIVE_REMOTE_HOST"
    fi
    log "remote listener cleanup after bind failure did not clear $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT; will retry later"
    exit 75
  fi

  rm -f "$CONTROL_SOCKET"
  exit "$ssh_code"
}

case "${1:-}" in
  install)
    install_agent
    ;;
  start)
    start_agent
    ;;
  stop)
    stop_agent
    ;;
  toggle)
    if loaded || master_connected; then
      stop_agent
    else
      start_agent
    fi
    ;;
  restart)
    stop_agent >/dev/null
    start_agent
    ;;
  status)
    status
    ;;
  quiet-status)
    master_connected
    ;;
  loaded-status)
    loaded
    ;;
  diagnose)
    diagnose
    ;;
  clear-remote-port)
    clear_remote_port
    ;;
  show-status)
    show_status_report
    ;;
  show-diagnose)
    show_diagnose_report
    ;;
  show-logs)
    show_logs_report
    ;;
  swiftbar-action)
    shift
    swiftbar_action "${1:-}"
    ;;
  run-once)
    run_once
    ;;
  logs)
    ensure_dirs
    touch "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    tail -f "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    ;;
  *)
    usage
    exit 64
    ;;
esac
