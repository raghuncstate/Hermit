#!/usr/bin/env bash
set -euo pipefail

LABEL="com.raghu.hermit-raghudt-tunnel"
REMOTE_USER="${HERMIT_TUNNEL_REMOTE_USER:-raghupathyk}"
REMOTE_HOST="${HERMIT_TUNNEL_REMOTE_HOST:-10.110.49.244}"
REMOTE_PORT="${HERMIT_TUNNEL_REMOTE_PORT:-22}"
REMOTE_LISTEN_HOST="${HERMIT_TUNNEL_REMOTE_LISTEN_HOST:-127.0.0.1}"
REMOTE_LISTEN_PORT="${HERMIT_TUNNEL_REMOTE_LISTEN_PORT:-22220}"
LOCAL_TARGET_HOST="${HERMIT_TUNNEL_LOCAL_TARGET_HOST:-127.0.0.1}"
LOCAL_TARGET_PORT="${HERMIT_TUNNEL_LOCAL_TARGET_PORT:-22}"
IDENTITY_FILE="${HERMIT_TUNNEL_IDENTITY_FILE:-$HOME/.ssh/hermit_raghudt_reverse_ed25519}"
APP_DIR="$HOME/Library/Application Support/Hermit"
LOG_DIR="$HOME/Library/Logs/Hermit"
CONTROL_SOCKET="$APP_DIR/raghudt-tunnel.ctl"
ACTION_STATE="$APP_DIR/raghudt-tunnel.last-action"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_PLIST_SOURCE="$SCRIPT_DIR/../launchd/$LABEL.plist"
if [[ ! -f "$DEFAULT_PLIST_SOURCE" ]]; then
  DEFAULT_PLIST_SOURCE="/Users/raghu/tmp/Hermit-tmux/launchd/$LABEL.plist"
fi
PLIST_SOURCE="${HERMIT_TUNNEL_PLIST_SOURCE:-$DEFAULT_PLIST_SOURCE}"
PLIST_DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

usage() {
  cat <<USAGE
Usage: hermit-raghudt-tunnel <command>

Commands:
  install       Install the user LaunchAgent
  start         Install/load the LaunchAgent and start the tunnel now
  stop          Stop and unload the LaunchAgent
  toggle        Start when stopped, stop when connected/loaded
  restart       Stop, then start
  status        Print human-readable status
  quiet-status  Exit 0 only when the SSH master tunnel is connected
  loaded-status Exit 0 only when the LaunchAgent is loaded
  diagnose      Print launchd status, checks, and recent logs
  swiftbar-action <command>
               Run a command from SwiftBar and record visible feedback
  run-once      Internal launchd command; run one foreground tunnel process
  logs          Tail the tunnel logs
USAGE
}

ensure_dirs() {
  mkdir -p "$APP_DIR" "$LOG_DIR" "$HOME/Library/LaunchAgents"
  chmod 700 "$APP_DIR"
}

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

loaded() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

master_connected() {
  [[ -S "$CONTROL_SOCKET" ]] || return 1
  /usr/bin/ssh \
    -S "$CONTROL_SOCKET" \
    -O check \
    -o BatchMode=yes \
    -o LogLevel=ERROR \
    "$REMOTE_USER@$REMOTE_HOST" >/dev/null 2>&1
}

install_agent() {
  ensure_dirs
  if [[ ! -f "$PLIST_SOURCE" ]]; then
    printf 'Missing LaunchAgent source: %s\n' "$PLIST_SOURCE" >&2
    return 1
  fi
  cp "$PLIST_SOURCE" "$PLIST_DEST"
  plutil -lint "$PLIST_DEST" >/dev/null
  chmod 644 "$PLIST_DEST"
  printf 'Installed %s\n' "$PLIST_DEST"
}

start_agent() {
  install_agent >/dev/null
  if loaded; then
    launchctl kickstart -k "$DOMAIN/$LABEL"
  else
    launchctl bootstrap "$DOMAIN" "$PLIST_DEST"
  fi
  sleep 1
  status || true
}

stop_agent() {
  if master_connected; then
    /usr/bin/ssh \
      -S "$CONTROL_SOCKET" \
      -O exit \
      -o BatchMode=yes \
      -o LogLevel=ERROR \
      "$REMOTE_USER@$REMOTE_HOST" >/dev/null 2>&1 || true
  fi
  if loaded; then
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  fi
  rm -f "$CONTROL_SOCKET"
  printf 'Hermit raghudt tunnel stopped\n'
}

status() {
  if master_connected; then
    printf 'connected: %s:%s -> %s:%s via %s@%s\n' \
      "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT" \
      "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" \
      "$REMOTE_USER" "$REMOTE_HOST"
    return 0
  fi

  if loaded; then
    printf 'retrying: LaunchAgent loaded but tunnel is not connected\n'
    print_recent_log_summary
    return 75
  fi

  printf 'stopped\n'
  return 1
}

print_recent_log_summary() {
  local last_log=""
  local last_error=""

  if [[ -f "$LOG_DIR/raghudt-tunnel.log" ]]; then
    last_log="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || true)"
  fi
  if [[ -f "$LOG_DIR/raghudt-tunnel.err.log" ]]; then
    last_error="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || true)"
  fi

  if [[ -n "$last_log" ]]; then
    printf 'last log: %s\n' "$last_log"
  fi
  if [[ -n "$last_error" ]]; then
    printf 'last error: %s\n' "$last_error"
  fi
}

notify() {
  local title="$1"
  local message="$2"
  /usr/bin/osascript -e "display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\"" >/dev/null 2>&1 || true
}

record_action() {
  ensure_dirs
  local command="$1"
  local code="$2"
  local output="$3"
  {
    printf '%s command=%s exit=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$command" "$code"
    printf '%s\n' "$output"
  } > "$ACTION_STATE"
}

swiftbar_action() {
  local command="${1:-}"
  if [[ -z "$command" ]]; then
    printf 'Missing SwiftBar command\n' >&2
    return 64
  fi

  record_action "$command" "running" "Running $command..."

  local output=""
  local code=0
  set +e
  output="$("$0" "$command" 2>&1)"
  code=$?
  set -e

  record_action "$command" "$code" "$output"

  local summary
  summary="$(printf '%s\n' "$output" | sed '/^[[:space:]]*$/d' | head -n 1)"
  if [[ -z "$summary" ]]; then
    summary="command finished with exit $code"
  fi

  notify "Hermit Tunnel" "$summary"
  printf '%s\n' "$output"
  return 0
}

diagnose() {
  ensure_dirs
  printf 'Hermit tunnel diagnosis\n'
  printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  printf 'Status:\n'
  status || true
  printf '\n'

  printf 'Checks:\n'
  if [[ -r "$IDENTITY_FILE" ]]; then
    printf '  identity: readable (%s)\n' "$IDENTITY_FILE"
  else
    printf '  identity: missing or unreadable (%s)\n' "$IDENTITY_FILE"
  fi
  if /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    printf '  remote SSH: reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  else
    printf '  remote SSH: NOT reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  fi
  if /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    printf '  local SSH: reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  else
    printf '  local SSH: NOT reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  fi
  printf '\n'

  printf 'LaunchAgent:\n'
  launchctl print "$DOMAIN/$LABEL" 2>&1 | sed -n '1,120p' || true
  printf '\n'

  printf 'Recent log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || printf '  no standard log yet\n'
  printf '\nRecent error log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || printf '  no error log yet\n'
}

run_once() {
  ensure_dirs
  umask 077

  if [[ ! -r "$IDENTITY_FILE" ]]; then
    log "identity file missing or unreadable: $IDENTITY_FILE"
    exit 78
  fi

  if master_connected; then
    log "tunnel already connected"
    exit 0
  fi

  rm -f "$CONTROL_SOCKET"

  if ! /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    log "raghudt is not reachable at $REMOTE_HOST:$REMOTE_PORT; will retry later"
    exit 75
  fi

  if ! /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    log "local SSH is not reachable at $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT"
    exit 75
  fi

  log "starting reverse tunnel: $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT -> $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT via $REMOTE_USER@$REMOTE_HOST"

  exec /usr/bin/ssh \
    -M \
    -S "$CONTROL_SOCKET" \
    -N \
    -T \
    -i "$IDENTITY_FILE" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -o LogLevel=ERROR \
    -R "$REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT:$LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT" \
    -p "$REMOTE_PORT" \
    "$REMOTE_USER@$REMOTE_HOST"
}

case "${1:-}" in
  install)
    install_agent
    ;;
  start)
    start_agent
    ;;
  stop)
    stop_agent
    ;;
  toggle)
    if loaded || master_connected; then
      stop_agent
    else
      start_agent
    fi
    ;;
  restart)
    stop_agent >/dev/null
    start_agent
    ;;
  status)
    status
    ;;
  quiet-status)
    master_connected
    ;;
  loaded-status)
    loaded
    ;;
  diagnose)
    diagnose
    ;;
  swiftbar-action)
    shift
    swiftbar_action "${1:-}"
    ;;
  run-once)
    run_once
    ;;
  logs)
    ensure_dirs
    touch "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    tail -f "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    ;;
  *)
    usage
    exit 64
    ;;
esac
