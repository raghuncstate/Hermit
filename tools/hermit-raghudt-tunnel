#!/usr/bin/env bash
set -euo pipefail

LABEL="com.raghu.hermit-raghudt-tunnel"
REMOTE_USER="${HERMIT_TUNNEL_REMOTE_USER:-raghupathyk}"
REMOTE_HOST="${HERMIT_TUNNEL_REMOTE_HOST:-10.110.49.244}"
REMOTE_PORT="${HERMIT_TUNNEL_REMOTE_PORT:-22}"
REMOTE_LISTEN_HOST="${HERMIT_TUNNEL_REMOTE_LISTEN_HOST:-127.0.0.1}"
REMOTE_LISTEN_PORT="${HERMIT_TUNNEL_REMOTE_LISTEN_PORT:-22220}"
LOCAL_TARGET_HOST="${HERMIT_TUNNEL_LOCAL_TARGET_HOST:-127.0.0.1}"
LOCAL_TARGET_PORT="${HERMIT_TUNNEL_LOCAL_TARGET_PORT:-22}"
IDENTITY_FILE="${HERMIT_TUNNEL_IDENTITY_FILE:-$HOME/.ssh/hermit_raghudt_reverse_ed25519}"
REMOTE_CLEANUP_ENABLED="${HERMIT_TUNNEL_REMOTE_CLEANUP_ENABLED:-1}"
REMOTE_CLEANUP_IDENTITY_FILE="${HERMIT_TUNNEL_REMOTE_CLEANUP_IDENTITY_FILE:-$HOME/.ssh/id_rsa}"
REMOTE_CLEANUP_MIN_AGE_SECONDS="${HERMIT_TUNNEL_REMOTE_CLEANUP_MIN_AGE_SECONDS:-120}"
APP_DIR="$HOME/Library/Application Support/Hermit"
LOG_DIR="$HOME/Library/Logs/Hermit"
CONTROL_SOCKET="$APP_DIR/raghudt-tunnel.ctl"
ACTION_STATE="$APP_DIR/raghudt-tunnel.last-action"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_PLIST_SOURCE="$SCRIPT_DIR/../launchd/$LABEL.plist"
if [[ ! -f "$DEFAULT_PLIST_SOURCE" ]]; then
  DEFAULT_PLIST_SOURCE="/Users/raghu/tmp/Hermit-tmux/launchd/$LABEL.plist"
fi
PLIST_SOURCE="${HERMIT_TUNNEL_PLIST_SOURCE:-$DEFAULT_PLIST_SOURCE}"
PLIST_DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

usage() {
  cat <<USAGE
Usage: hermit-raghudt-tunnel <command>

Commands:
  install       Install the user LaunchAgent
  start         Install/load the LaunchAgent and start the tunnel now
  stop          Stop and unload the LaunchAgent
  toggle        Start when stopped, stop when connected/loaded
  restart       Stop, then start
  status        Print human-readable status
  quiet-status  Exit 0 only when the SSH master tunnel is connected
  loaded-status Exit 0 only when the LaunchAgent is loaded
  diagnose      Print launchd status, checks, and recent logs
  clear-remote-port
               Clear a stale raghudt listener on the reverse tunnel port
  show-status   Open a status report in TextEdit
  show-diagnose Open a diagnosis report in TextEdit
  show-logs     Open recent logs in TextEdit and Finder
  swiftbar-action <command>
               Run a command from SwiftBar and record visible feedback
  run-once      Internal launchd command; run one foreground tunnel process
  logs          Tail the tunnel logs
USAGE
}

ensure_dirs() {
  mkdir -p "$APP_DIR" "$LOG_DIR" "$HOME/Library/LaunchAgents"
  chmod 700 "$APP_DIR"
}

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

loaded() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

master_connected() {
  [[ -S "$CONTROL_SOCKET" ]] || return 1
  /usr/bin/ssh \
    -S "$CONTROL_SOCKET" \
    -O check \
    -o BatchMode=yes \
    -o LogLevel=ERROR \
    "$REMOTE_USER@$REMOTE_HOST" >/dev/null 2>&1
}

install_agent() {
  ensure_dirs
  if [[ ! -f "$PLIST_SOURCE" ]]; then
    printf 'Missing LaunchAgent source: %s\n' "$PLIST_SOURCE" >&2
    return 1
  fi
  cp "$PLIST_SOURCE" "$PLIST_DEST"
  plutil -lint "$PLIST_DEST" >/dev/null
  chmod 644 "$PLIST_DEST"
  printf 'Installed %s\n' "$PLIST_DEST"
}

start_agent() {
  install_agent >/dev/null
  if master_connected; then
    status
    return 0
  fi

  if loaded; then
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  fi
  launchctl bootstrap "$DOMAIN" "$PLIST_DEST"
  sleep 1
  status || true
}

stop_agent() {
  if master_connected; then
    /usr/bin/ssh \
      -S "$CONTROL_SOCKET" \
      -O exit \
      -o BatchMode=yes \
      -o LogLevel=ERROR \
      "$REMOTE_USER@$REMOTE_HOST" >/dev/null 2>&1 || true
  fi
  if loaded; then
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  fi
  rm -f "$CONTROL_SOCKET"
  printf 'Hermit raghudt tunnel stopped\n'
}

status() {
  if master_connected; then
    printf 'connected: %s:%s -> %s:%s via %s@%s\n' \
      "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT" \
      "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" \
      "$REMOTE_USER" "$REMOTE_HOST"
    return 0
  fi

  if loaded; then
    printf 'retrying: LaunchAgent loaded but tunnel is not connected\n'
    print_recent_log_summary
    return 75
  fi

  printf 'stopped\n'
  return 1
}

print_recent_log_summary() {
  local last_log=""
  local last_error=""

  if [[ -f "$LOG_DIR/raghudt-tunnel.log" ]]; then
    last_log="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || true)"
  fi
  if [[ -f "$LOG_DIR/raghudt-tunnel.err.log" ]]; then
    last_error="$(tail -n 1 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || true)"
  fi

  if [[ -n "$last_log" ]]; then
    printf 'last log: %s\n' "$last_log"
  fi
  if [[ -n "$last_error" ]]; then
    printf 'last error: %s\n' "$last_error"
  fi
}

remote_cleanup_ssh() {
  local args=(
    -x
    -o BatchMode=yes
    -o ConnectTimeout=10
    -o StrictHostKeyChecking=accept-new
    -p "$REMOTE_PORT"
  )

  if [[ -r "$REMOTE_CLEANUP_IDENTITY_FILE" ]]; then
    args+=(-i "$REMOTE_CLEANUP_IDENTITY_FILE" -o IdentitiesOnly=yes)
  fi

  /usr/bin/ssh "${args[@]}" "$REMOTE_USER@$REMOTE_HOST" "$@"
}

remote_listener_status() {
  local output=""
  local code=0

  set +e
  output="$(remote_cleanup_ssh /usr/bin/python3 - "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT" <<'PY' 2>&1
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
try:
    with socket.create_connection((host, port), timeout=2):
        pass
    print("HERMIT_PROBE_OCCUPIED")
except OSError:
    print("HERMIT_PROBE_CLEAR")
PY
)"
  code=$?
  set -e

  if [[ "$code" -ne 0 ]]; then
    [[ -n "$output" ]] && printf '%s\n' "$output" >&2
    return 75
  fi
  if grep -qx 'HERMIT_PROBE_OCCUPIED' <<< "$output"; then
    return 0
  fi
  if grep -qx 'HERMIT_PROBE_CLEAR' <<< "$output"; then
    return 1
  fi

  [[ -n "$output" ]] && printf '%s\n' "$output" >&2
  return 75
}

remote_listener_occupied() {
  remote_listener_status
}

clear_remote_port() {
  if [[ "$REMOTE_CLEANUP_ENABLED" != "1" ]]; then
    printf 'remote cleanup disabled (HERMIT_TUNNEL_REMOTE_CLEANUP_ENABLED=%s)\n' "$REMOTE_CLEANUP_ENABLED"
    return 75
  fi

  if master_connected; then
    printf 'current tunnel is connected; not clearing remote listener: %s:%s\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
    return 0
  fi

  if ! /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    printf 'raghudt is not reachable at %s:%s; cannot clear remote port\n' "$REMOTE_HOST" "$REMOTE_PORT"
    return 75
  fi

  local probe_output=""
  local probe_code=0
  set +e
  probe_output="$(remote_listener_status 2>&1)"
  probe_code=$?
  set -e
  case "$probe_code" in
    0)
      ;;
    1)
      printf 'remote listener is already clear: %s:%s\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
      return 0
      ;;
    *)
      printf 'remote listener probe failed for %s:%s\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
      [[ -n "$probe_output" ]] && printf '%s\n' "$probe_output"
      return 75
      ;;
  esac

  remote_cleanup_ssh /bin/bash -s -- \
    "$REMOTE_LISTEN_HOST" \
    "$REMOTE_LISTEN_PORT" \
    "$REMOTE_CLEANUP_MIN_AGE_SECONDS" \
    "$REMOTE_USER" <<'REMOTE'
set -euo pipefail

listen_host="$1"
listen_port="$2"
min_age="$3"
remote_user="$4"
remote_uid="$(id -u "$remote_user" 2>/dev/null || id -u)"

occupied() {
  /usr/bin/python3 - "$listen_host" "$listen_port" <<'PY' >/dev/null 2>&1
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
try:
    with socket.create_connection((host, port), timeout=2):
        pass
except OSError:
    raise SystemExit(1)
PY
}

listener_pids() {
  local pids=()

  if command -v ss >/dev/null 2>&1; then
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if [[ "$line" != *":$listen_port "* && "$line" != *":$listen_port"* ]]; then
        continue
      fi
      while [[ "$line" =~ pid=([0-9]+) ]]; do
        pids+=("${BASH_REMATCH[1]}")
        line="${line#*pid=${BASH_REMATCH[1]}}"
      done
    done < <(ss -H -ltnp "sport = :$listen_port" 2>/dev/null || true)
  fi

  if [[ ${#pids[@]} -eq 0 ]] && command -v lsof >/dev/null 2>&1; then
    while IFS= read -r pid; do
      [[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
    done < <(lsof -nP -iTCP@"$listen_host":"$listen_port" -sTCP:LISTEN -t 2>/dev/null || true)
  fi

  if [[ ${#pids[@]} -eq 0 ]] && command -v fuser >/dev/null 2>&1; then
    while IFS= read -r pid; do
      [[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
    done < <(fuser -n tcp "$listen_port" 2>/dev/null | tr ' ' '\n' || true)
  fi

  if [[ ${#pids[@]} -gt 0 ]]; then
    printf '%s\n' "${pids[@]}" | awk '!seen[$0]++'
  fi
}

set +e
occupied
probe_code=$?
set -e
if [[ "$probe_code" -eq 1 ]]; then
  printf 'remote listener is already clear: %s:%s\n' "$listen_host" "$listen_port"
  exit 0
elif [[ "$probe_code" -ne 0 ]]; then
  printf 'remote listener probe failed before cleanup: %s:%s\n' "$listen_host" "$listen_port"
  exit 75
fi

mapfile -t candidates < <(
  while IFS= read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue

    line="$(ps -o uid=,etimes=,comm=,args= -p "$pid" 2>/dev/null || true)"
    [[ -n "$line" ]] || continue

    uid="$(awk '{print $1}' <<< "$line")"
    etimes="$(awk '{print $2}' <<< "$line")"
    comm="$(awk '{print $3}' <<< "$line")"
    args="$(cut -d' ' -f4- <<< "$line" | sed 's/^[[:space:]]*//')"

    if [[ "$uid" != "$remote_uid" && "$uid" != "$(id -u)" ]]; then
      printf 'skip pid=%s: owned by uid %s, not %s\n' "$pid" "$uid" "$remote_uid" >&2
      continue
    fi
    if [[ ! "$etimes" =~ ^[0-9]+$ || "$etimes" -lt "$min_age" ]]; then
      printf 'skip pid=%s: age %ss is younger than %ss\n' "$pid" "${etimes:-unknown}" "$min_age" >&2
      continue
    fi
    is_ssh_listener=0
    is_socat_listener=0
    if [[ "$comm" == *ssh* || "$args" == *ssh* ]]; then
      is_ssh_listener=1
    fi
    if [[ "$comm" == "socat" && "$args" == *"TCP-LISTEN:$listen_port"* && "$args" == *"bind=$listen_host"* ]]; then
      is_socat_listener=1
    fi
    if [[ "$is_ssh_listener" != "1" && "$is_socat_listener" != "1" ]]; then
      printf 'skip pid=%s: listener is not an expected Hermit SSH/socat listener: %s\n' "$pid" "$args" >&2
      continue
    fi

    printf '%s:%s:%s\n' "$pid" "$etimes" "$args"
  done < <(listener_pids)
)

if [[ ${#candidates[@]} -eq 0 ]]; then
  printf 'remote listener is occupied, but no safe stale Hermit listener candidate was found\n'
  exit 75
fi

for candidate in "${candidates[@]}"; do
  pid="${candidate%%:*}"
  rest="${candidate#*:}"
  age="${rest%%:*}"
  args="${rest#*:}"
  printf 'killing stale remote ssh listener pid=%s age=%ss args=%s\n' "$pid" "$age" "$args"
  kill "$pid" 2>/dev/null || true
done

sleep 1

set +e
occupied
probe_code=$?
set -e
if [[ "$probe_code" -eq 0 ]]; then
  printf 'remote listener is still occupied after cleanup: %s:%s\n' "$listen_host" "$listen_port"
  exit 75
elif [[ "$probe_code" -ne 1 ]]; then
  printf 'remote listener probe failed after cleanup: %s:%s\n' "$listen_host" "$listen_port"
  exit 75
fi

printf 'remote listener cleared: %s:%s\n' "$listen_host" "$listen_port"
REMOTE
}

clear_remote_port_if_needed() {
  [[ "$REMOTE_CLEANUP_ENABLED" == "1" ]] || return 0
  local probe_output=""
  local probe_code=0
  set +e
  probe_output="$(remote_listener_status 2>&1)"
  probe_code=$?
  set -e
  case "$probe_code" in
    0)
      ;;
    1)
      return 0
      ;;
    *)
      log "remote listener probe failed for $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT"
      while IFS= read -r line; do
        [[ -n "$line" ]] && log "remote probe: $line"
      done <<< "$probe_output"
      return 75
      ;;
  esac

  log "remote listener is occupied at $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT; attempting stale cleanup"
  local output=""
  local code=0
  set +e
  output="$(clear_remote_port 2>&1)"
  code=$?
  set -e
  while IFS= read -r line; do
    [[ -n "$line" ]] && log "remote cleanup: $line"
  done <<< "$output"
  return "$code"
}

notify() {
  local title="$1"
  local message="$2"
  /usr/bin/osascript -e "display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\"" >/dev/null 2>&1 || true
}

record_action() {
  ensure_dirs
  local command="$1"
  local code="$2"
  local output="$3"
  {
    printf '%s command=%s exit=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$command" "$code"
    printf '%s\n' "$output"
  } > "$ACTION_STATE"
}

write_status_report() {
  ensure_dirs
  local file="$APP_DIR/raghudt-tunnel-status.txt"
  {
    printf 'Hermit tunnel status\n'
    printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    status || true
  } > "$file"
  printf '%s\n' "$file"
}

write_diagnose_report() {
  ensure_dirs
  local file="$APP_DIR/raghudt-tunnel-diagnose.txt"
  diagnose > "$file" 2>&1 || true
  printf '%s\n' "$file"
}

write_logs_report() {
  ensure_dirs
  touch "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
  local file="$APP_DIR/raghudt-tunnel-logs.txt"
  {
    printf 'Hermit tunnel logs\n'
    printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'Standard log: %s\n' "$LOG_DIR/raghudt-tunnel.log"
    tail -n 200 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || true
    printf '\nError log: %s\n' "$LOG_DIR/raghudt-tunnel.err.log"
    tail -n 200 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || true
  } > "$file"
  printf '%s\n' "$file"
}

open_report() {
  local file="$1"
  /usr/bin/open -a TextEdit "$file"
}

show_status_report() {
  local file
  file="$(write_status_report)"
  open_report "$file"
  printf 'Opened status report: %s\n' "$file"
}

show_diagnose_report() {
  local file
  file="$(write_diagnose_report)"
  open_report "$file"
  printf 'Opened diagnosis report: %s\n' "$file"
}

show_logs_report() {
  local file
  file="$(write_logs_report)"
  open_report "$file"
  /usr/bin/open "$LOG_DIR" >/dev/null 2>&1 || true
  printf 'Opened logs report: %s\n' "$file"
  printf 'Opened log folder: %s\n' "$LOG_DIR"
}

swiftbar_action() {
  local command="${1:-}"
  if [[ -z "$command" ]]; then
    printf 'Missing SwiftBar command\n' >&2
    return 64
  fi

  record_action "$command" "running" "Running $command..."

  local output=""
  local code=0
  set +e
  case "$command" in
    show-status)
      output="$(show_status_report 2>&1)"
      ;;
    show-diagnose)
      output="$(show_diagnose_report 2>&1)"
      ;;
    show-logs)
      output="$(show_logs_report 2>&1)"
      ;;
    *)
      output="$("$0" "$command" 2>&1)"
      ;;
  esac
  code=$?
  set -e

  record_action "$command" "$code" "$output"

  local summary
  summary="$(printf '%s\n' "$output" | sed '/^[[:space:]]*$/d' | head -n 1)"
  if [[ -z "$summary" ]]; then
    summary="command finished with exit $code"
  fi

  notify "Hermit Tunnel" "$summary"
  printf '%s\n' "$output"
  return 0
}

diagnose() {
  ensure_dirs
  printf 'Hermit tunnel diagnosis\n'
  printf 'Generated: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  printf 'Status:\n'
  status || true
  printf '\n'

  printf 'Checks:\n'
  if [[ -r "$IDENTITY_FILE" ]]; then
    printf '  identity: readable (%s)\n' "$IDENTITY_FILE"
  else
    printf '  identity: missing or unreadable (%s)\n' "$IDENTITY_FILE"
  fi
  if /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    printf '  remote SSH: reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  else
    printf '  remote SSH: NOT reachable (%s:%s)\n' "$REMOTE_HOST" "$REMOTE_PORT"
  fi
  if /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    printf '  local SSH: reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  else
    printf '  local SSH: NOT reachable (%s:%s)\n' "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT"
  fi
  local diagnose_probe_output=""
  local diagnose_probe_code=0
  set +e
  diagnose_probe_output="$(remote_listener_status 2>&1)"
  diagnose_probe_code=$?
  set -e
  case "$diagnose_probe_code" in
    0)
      printf '  remote listener: occupied (%s:%s)\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
      ;;
    1)
      printf '  remote listener: clear (%s:%s)\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
      ;;
    *)
      printf '  remote listener: probe failed (%s:%s)\n' "$REMOTE_LISTEN_HOST" "$REMOTE_LISTEN_PORT"
      [[ -n "$diagnose_probe_output" ]] && printf '%s\n' "$diagnose_probe_output" | sed 's/^/    /'
      ;;
  esac
  printf '\n'

  printf 'LaunchAgent:\n'
  launchctl print "$DOMAIN/$LABEL" 2>&1 | sed -n '1,120p' || true
  printf '\n'

  printf 'Recent log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.log" 2>/dev/null || printf '  no standard log yet\n'
  printf '\nRecent error log:\n'
  tail -n 30 "$LOG_DIR/raghudt-tunnel.err.log" 2>/dev/null || printf '  no error log yet\n'
}

run_once() {
  ensure_dirs
  umask 077

  if [[ ! -r "$IDENTITY_FILE" ]]; then
    log "identity file missing or unreadable: $IDENTITY_FILE"
    exit 78
  fi

  if master_connected; then
    log "tunnel already connected"
    exit 0
  fi

  rm -f "$CONTROL_SOCKET"

  if ! /usr/bin/nc -G 5 -z "$REMOTE_HOST" "$REMOTE_PORT" >/dev/null 2>&1; then
    log "raghudt is not reachable at $REMOTE_HOST:$REMOTE_PORT; will retry later"
    exit 75
  fi

  if ! /usr/bin/nc -G 2 -z "$LOCAL_TARGET_HOST" "$LOCAL_TARGET_PORT" >/dev/null 2>&1; then
    log "local SSH is not reachable at $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT"
    exit 75
  fi

  if ! clear_remote_port_if_needed; then
    log "remote listener cleanup did not clear $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT; will retry later"
    exit 75
  fi

  log "starting reverse tunnel: $REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT -> $LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT via $REMOTE_USER@$REMOTE_HOST"

  exec /usr/bin/ssh \
    -M \
    -S "$CONTROL_SOCKET" \
    -N \
    -T \
    -i "$IDENTITY_FILE" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -o LogLevel=ERROR \
    -R "$REMOTE_LISTEN_HOST:$REMOTE_LISTEN_PORT:$LOCAL_TARGET_HOST:$LOCAL_TARGET_PORT" \
    -p "$REMOTE_PORT" \
    "$REMOTE_USER@$REMOTE_HOST"
}

case "${1:-}" in
  install)
    install_agent
    ;;
  start)
    start_agent
    ;;
  stop)
    stop_agent
    ;;
  toggle)
    if loaded || master_connected; then
      stop_agent
    else
      start_agent
    fi
    ;;
  restart)
    stop_agent >/dev/null
    start_agent
    ;;
  status)
    status
    ;;
  quiet-status)
    master_connected
    ;;
  loaded-status)
    loaded
    ;;
  diagnose)
    diagnose
    ;;
  clear-remote-port)
    clear_remote_port
    ;;
  show-status)
    show_status_report
    ;;
  show-diagnose)
    show_diagnose_report
    ;;
  show-logs)
    show_logs_report
    ;;
  swiftbar-action)
    shift
    swiftbar_action "${1:-}"
    ;;
  run-once)
    run_once
    ;;
  logs)
    ensure_dirs
    touch "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    tail -f "$LOG_DIR/raghudt-tunnel.log" "$LOG_DIR/raghudt-tunnel.err.log"
    ;;
  *)
    usage
    exit 64
    ;;
esac
